# Neon Superpowers — local credentials (never committed)
# Fill available values here, save, then tell Codex “keys ready”.
# Do not paste credentials into chat. Blank fields remain disabled.

# 1. Inference — Neon AI Gateway token, bare base URL, model ID
NEON_AI_GATEWAY_TOKEN=
NEON_AI_GATEWAY_BASE_URL=
NEON_MODEL=
# Optional vision-capable model for Goldfish evaluation
NEON_GOLDFISH_MODEL=

# 2. Personal Gmail + Google Calendar — Composio project API key
COMPOSIO_API_KEY=
COMPOSIO_USER_ID=neon-local
# Optional: existing auth configuration / connected account IDs
COMPOSIO_GMAIL_AUTH_CONFIG_ID=
COMPOSIO_CALENDAR_AUTH_CONFIG_ID=
COMPOSIO_GMAIL_CONNECTED_ACCOUNT_ID=
COMPOSIO_GOOGLECALENDAR_CONNECTED_ACCOUNT_ID=

# 3. Research, browser and remote computation
EXA_API_KEY=
KERNEL_API_KEY=
SPRITES_TOKEN=
EXECUTOR_API_KEY=
EXECUTOR_MCP_URL=https://v2.executor.sh/mcp

# 4. Agent-owned inbox — inbox ID optional until one is created
AGENTMAIL_API_KEY=
AGENTMAIL_INBOX_ID=
# Your controlled recipient address for the approved demo send
NEON_DEMO_RECIPIENT=

# 5. Optional explicit snapshot sharing — Postgres connection string
NEON_DATABASE_URL=

# Mastra and Assistant UI need no runtime key for local use.
# CodeRabbit uses its GitHub App installation, not a key here.
